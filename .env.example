# ─────────────────────────────────────────────────────────
# CyberMind AI - Configuration File
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your API key below
# 3. Never commit .env to git (it's in .gitignore)
# ─────────────────────────────────────────────────────────

# ── REQUIRED: Groq API Key (FREE at https://console.groq.com) ──────────────
# Sign up → Go to API Keys → Create → Copy here
GROQ_API_KEY=gsk_YOUR_KEY_HERE

# ── OPTIONAL: Backup API (in case Groq rate limits hit) ───────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_KEY=

# ── AI Model Settings ─────────────────────────────────────────────────────
# Best free model for cybersecurity reasoning:
AI_MODEL=llama-3.3-70b-versatile
# Alternatives: mixtral-8x7b-32768, llama3-70b-8192

# ── Report Settings ───────────────────────────────────────────────────────
REPORT_DIR=./reports
MEMORY_DIR=./memory_db
AUTO_GENERATE_REPORT=true

# ── Safety Settings ───────────────────────────────────────────────────────
# Set to true to skip confirmation for LOW risk steps (recon only)
AUTO_APPROVE_RECON=false
# Max time (seconds) to wait for a scan command
SCAN_TIMEOUT=300

# ── Debug ─────────────────────────────────────────────────────────────────
DEBUG=false
